# Normalize line endings for text files
* text=auto

# Unity YAML assets (text, but merge conflicts should be resolved manually)
*.unity text eol=lf
*.prefab text eol=lf
*.asset text eol=lf
*.mat text eol=lf
*.anim text eol=lf
*.controller text eol=lf
*.overrideController text eol=lf
*.physicMaterial text eol=lf
*.mask text eol=lf
*.preset text eol=lf
*.meta text eol=lf
*.asmdef text eol=lf
*.asmref text eol=lf

# Source and configuration
*.cs text diff=csharp
*.shader text
*.cginc text
*.hlsl text
*.json text
*.md text
*.yml text
*.yaml text
*.txt text

# Binary assets
*.fbx binary
*.FBX binary
*.png binary
*.jpg binary
*.jpeg binary
*.psd binary
*.tga binary
*.exr binary
*.hdr binary
*.mp3 binary
*.wav binary
*.ogg binary
*.dll binary
*.so binary
*.dylib binary
*.a binary
*.unitypackage binary
*.zip binary
*.apk binary
*.aab binary
